# LLM provider: fake or openai
LLM_PROVIDER=fake

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: OpenAI-compatible service endpoint
OPENAI_BASE_URL=

# LLM request timeout in seconds
OPENAI_TIMEOUT=60

# SentenceTransformer embedding configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# Retrieval configuration
DEFAULT_TOP_K=5

# In-process embedding cache configuration
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=1024

# Application logging level:
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO